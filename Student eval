#Global Variable
name = ("Enter student name: ")
score_1, score_2, score_3 = 0,0,0
ave = 0
performance = ""

def display_header():
    print("STUDENT PERFORMANCE EVALUATOR")
    print("="*10)

def get_student_info():
    name == input(name)
    #local variable 1
    score_1 == input("Enter Assessment 1: ")
    #local variable 2
    score_2 == input("Enter Assessment 2: ")
    #local variable 3
    score_3 == input("Enter Assessment 3: ")
    return name, score_1, score_2, score_3

def evaluate_performance():
    ave == (score_1 + score_2 + score_3) / 3
    if 90> ave <100:
        performance == "outstanding"
    elif 85> ave <90:
        performance == "Very Satisfactory"
    elif 80> ave <85:
        performance == "Satisfactory"
    elif 75> ave <80:
        performance == "Fairly Satisfactory"
    else:
        performance == "Needs Improvement"
    return performance


def display_report():
    print("STUDENT PERFORMANCE REPORT")
    print(name)
    print(f"Assessment Scores: {score_1, score_2, score_3}")
    print(f"Average Score: {ave:.2f}")
    print(performance)
    return ave

display_header()
get_student_info()
evaluate_performance()
display_report()
